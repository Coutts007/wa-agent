# ---- LLM -------------------------------------------------------------------
# anthropic | gemini | mock   (mock = offline, for testing the plumbing)
LLM_PROVIDER=anthropic
# Leave empty for the provider default (anthropic: claude-sonnet-5-5, gemini: gemini-3.8-flash).
# Cheaper options: claude-haiku-5-5 / gemini-3.5-flash-lite
LLM_MODEL=
# Optional second model used automatically when the main one returns 503/529/429 (overloaded,
# rate-limited). Same provider. E.g. gemini-flash-lite-latest or claude-haiku-5-5.
LLM_FALLBACK_MODEL=
# Gemini only: thinking-token budget per reply. 0 (default) = off, which keeps short replies
# complete and fast. -1 = model default. Thoughts count against the reply length.
LLM_THINKING_BUDGET=0
# Set the key for the provider you chose (no quotes, no spaces).
# Anthropic: platform.claude.com -> API keys (sk-ant-api03-...). Needs API credits.
# Gemini: aistudio.google.com -> Get API key. Has a free tier.
ANTHROPIC_API_KEY=
# Only for personal Anthropic keys (sk-ant-usr-...) not tied to a single workspace.
# Console -> Workspaces -> copy the ID (wrkspc_...). Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
# Optional override that takes priority over both of the above. Leave empty normally.
LLM_API_KEY=

# ---- You -------------------------------------------------------------------
OWNER_NAME=Your Name
# Your WhatsApp number, digits only with country code. Optional but recommended:
# it makes sure the bot recognises your "message yourself" chat even when
# WhatsApp uses its newer LID identifiers.
OWNER_NUMBER=2547XXXXXXXX
# Set this to link with a pairing code instead of scanning a QR (digits only).
PAIRING_NUMBER=

# Free text the assistant may use to answer people on your behalf.
PERSONA="Software developer and student. Usually free to talk after 6pm. For anything urgent, people can call."

# ---- Auto-reply --------------------------------------------------------------
AUTO_REPLY_ENABLED=true
AUTO_REPLY_GROUPS=false           # reply in groups only when @mentioned
AUTO_REPLY_ALLOW=                 # comma-separated numbers; empty = everyone
AUTO_REPLY_BLOCK=                 # comma-separated numbers that never get a reply
MANUAL_REPLY_COOLDOWN_MIN=30      # after you reply from your phone, stay quiet in that chat
AUTO_REPLY_MIN_GAP_SEC=20         # per-chat minimum gap between auto-replies
AUTO_REPLY_MAX_PER_HOUR=60        # global safety cap
AUTO_REPLY_MARK_READ=true
HISTORY_TURNS=12

# ---- Statuses ----------------------------------------------------------------
STATUS_CAPTURE=true
STATUS_DESCRIBE_MEDIA=true        # one vision call per image/video status
STATUS_AUTO_VIEW=false            # true = posters see that you viewed their status

# ---- Misc --------------------------------------------------------------------
COMMAND_PREFIX=/
DB_PATH=./data/wa-agent.db
AUTH_DIR=./auth
LOG_LEVEL=info                    # fatal|error|warn|info|debug
BAILEYS_LOG_LEVEL=warn
